# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# PyInstaller & build outputs
build/
build-*/
dist/
dist-*/
.release-build/
*.spec.bak

# Preserve official release binaries
!release/
!release/SpotifyOptimizer.exe

# Locally retained previous builds (kept on disk, not committed)
release/SpotifyOptimizer-*.exe

# Audit sandboxes & temporary test profiles
.audit-*

# Temporary test screenshots & captures
screenshots/
test_shot.png
*.png
!docs/screenshots/
!docs/screenshots/*.png
!assets/
!assets/*.png
!assets/*.ico

# IDE / Editor local files (keep workspace settings if shared, ignore personal state)
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo

# Environment & local config overrides
.env
.env.*
!.env.example
.venv/
env/
venv/

# Local user data — never committed
backups/*
!backups/.gitkeep
*.sqlite
*.sqlite3
*.db
*.log
*.prof
*.tmp
*.temp

# Release binaries belong in GitHub Releases, not source history
release/*.exe
!release/SHA256SUMS.txt
